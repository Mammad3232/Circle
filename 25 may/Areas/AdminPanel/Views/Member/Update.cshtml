@using _25_may.Areas.AdminPanel.ViewModel
@model UpdateVM

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Default form</h4>

         
      
            <form class="forms-sample" method="post">
                <div class="form-group">
                    <label asp-for="ImageURL">Photo</label>
                    <input type="text" class="form-control" placeholder="Username" asp-for="ImageURL">
                    <span asp-validation-for="ImageURL"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Title">Name</label>
                    <input type="text" class="form-control" placeholder="Email" asp-for="Title">
                    <span asp-validation-for="Title"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Descriiption">Description</label>
                    <input type="text" class="form-control" placeholder="Password" asp-for="Descriiption">
                    <span asp-validation-for="Descriiption"></span>
                </div>


                <button type="submit" class="btn btn-primary me-2">Create</button>
                <a class="btn btn-light" asp-controller="Member" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>