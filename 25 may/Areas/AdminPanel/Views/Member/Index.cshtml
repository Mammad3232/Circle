@using _25_may.Models



@model IEnumerable<History>
@{
    int count = 1;
}
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Member table</h4>
            <a class="btn btn-primary" asp-controller="Member" asp-action="Create">Create</a>
            <div class="table-responsive pt-3">
                <table class="table table-dark">
                    <thead>
                        <tr>
                            <th>
                                Count
                            </th>
                            <th>
                               Photo
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Description
                            </th>
                            <th>
                                Settings
                            </th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach(var item in Model)
                        {
                        <tr>
                            <td>
                                @count
                            </td>
                            <td>
                                <img src="~/images/team/@item.ImageURL" />
                            </td>
                            <td>
                               @item.Title  
                            </td>
                            <td>
                               @item.Descriiption
                            </td>
                            <td>
                                    <a class="btn btn-warning" asp-action="Update" asp-route-id=" @item.Id ">Update</a>
                                    <a class="btn btn-danger" asp-action="Delete" asp-route-id=" @item.Id ">Delete</a>

                            </td>
                            </tr>
                            count++;
                        }
         
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>